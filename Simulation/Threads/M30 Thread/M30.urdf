<?xml version="1.0"?>
<!--
  M30 thread: threaded base + nut on a continuous revolute and a prismatic
  joint along the thread axis. Upstream M30.urdf put the prismatic joint on the
  base instead of the nut and had the plate normal on +Z; this re-authoring
  chains revolute -> prismatic -> nut and turns the plate normal to +X like the
  other mechanisms.
  The base collides as primitives (its hull is a cone over the thread).
  PrismaticJoint = 0 seats the nut on the plate; +X unscrews it.
-->
<robot name="M30">
  <link name="World">
    <inertial><origin xyz="0.0325 0 0" rpy="0 0 0" /><mass value="0.4369" /><inertia ixx="0.000494543" ixy="0" ixz="0" iyy="0.000436426" iyz="0" izz="0.000365777" /></inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5707963 0" />
      <geometry><mesh filename="meshes/Base_Corpo1.obj" scale="1 1 1" /></geometry>
    </visual>
    <collision>
      <origin xyz="0.0075 0 0" rpy="0 0 0" />
      <geometry><box size="0.015 0.076 0.076" /></geometry>
    </collision>
    <collision>
      <origin xyz="0.040 0 0" rpy="0 1.5707963 0" />
      <geometry><cylinder radius="0.0150" length="0.050" /></geometry>
    </collision>
  </link>
  <link name="rot_pivot">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.005" /><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06" /></inertial>
  </link>
  <link name="Nut">
    <inertial><origin xyz="0 0 0.012" rpy="0 0 0" /><mass value="0.0586" /><inertia ixx="1.66017e-05" ixy="0" ixz="0" iyy="1.3155e-05" iyz="0" izz="2.41272e-05" /></inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -0.4439008" />
      <geometry><mesh filename="meshes/Nut_Corpo1.obj" scale="1 1 1" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -0.4439008" />
      <geometry><mesh filename="meshes/Nut_Corpo1.obj" scale="1 1 1" /></geometry>
    </collision>
  </link>
  <!-- Child frames have +Z along the thread, which is World +X. -->
  <joint name="RevoluteJoint" type="continuous">
    <origin xyz="0.015649 0 0" rpy="0 1.5707963 0" />
    <parent link="World" />
    <child link="rot_pivot" />
    <axis xyz="0 0 1" />
  </joint>
  <joint name="PrismaticJoint" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="rot_pivot" />
    <child link="Nut" />
    <axis xyz="0 0 1" />
    <limit lower="0.0" upper="0.025" effort="100.0" velocity="1.0" />
  </joint>
</robot>