<?xml version="1.0"?>
<!--
  M8 thread: screw base + nut on a continuous revolute and a prismatic joint
  along the screw axis (+X). Upstream collides with the base mesh, whose single
  convex hull is a cone from the plate to the screw tip that fingers cannot
  reach past; the base here collides as primitives instead.
  PrismaticJoint = 0 seats the nut on the collar; +X unscrews it off the tip.
-->
<robot name="M8_Assy">
  <link name="World">
    <inertial><origin xyz="-0.018 0 0" rpy="0 0 0" /><mass value="0.3025" /><inertia ixx="0.000342376" ixy="0" ixz="0" iyy="0.000197776" iyz="0" izz="0.000246687" /></inertial>
    <visual>
      <origin xyz="-0.0253536 0 0" rpy="0 1.5707963 0" />
      <geometry><mesh filename="meshes/M8_Screw_Base_Corpo1_Mesh.obj" scale="1 1 1" /></geometry>
    </visual>
    <collision>
      <origin xyz="-0.0178536 0 0" rpy="0 0 0" />
      <geometry><box size="0.015 0.076 0.076" /></geometry>
    </collision>
    <collision>
      <origin xyz="-0.0052 0 0" rpy="0 1.5707963 0" />
      <geometry><cylinder radius="0.0053" length="0.0104" /></geometry>
    </collision>
    <collision>
      <origin xyz="0.0098 0 0" rpy="0 1.5707963 0" />
      <geometry><cylinder radius="0.0036" length="0.0196" /></geometry>
    </collision>
  </link>
  <link name="rot_pivot">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.005" /><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06" /></inertial>
  </link>
  <link name="nut_pivot">
    <!-- CAD mass is ~1 g; 20 g keeps the grasp contacts stable. -->
    <inertial><origin xyz="0.003 0 0" rpy="0 0 0" /><mass value="0.02" /><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06" /></inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5707963 0" />
      <geometry><mesh filename="meshes/M8_Nut_Corpo1_Mesh.obj" scale="1 1 1" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707963 0" />
      <geometry><mesh filename="meshes/M8_Nut_Corpo1_Mesh.obj" scale="1 1 1" /></geometry>
    </collision>
  </link>
  <joint name="RevoluteJoint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="World" />
    <child link="rot_pivot" />
    <axis xyz="1 0 0" />
  </joint>
  <joint name="PrismaticJoint" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="rot_pivot" />
    <child link="nut_pivot" />
    <axis xyz="1 0 0" />
    <limit lower="0.0" upper="0.015" effort="100.0" velocity="1.0" />
  </joint>
</robot>