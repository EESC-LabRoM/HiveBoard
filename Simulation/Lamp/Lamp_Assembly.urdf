<?xml version='1.0' encoding='utf-8'?>
<robot name="Lamp_Assembly">
  <joint name="PrismaticJoint" type="prismatic">
    <origin xyz="-0. 0. -0." rpy="0. 0. 0." />
    <parent link="rotation_pivot" />
    <child link="lamp_pivot" />
    <axis xyz="1. 0. 0." />
    <limit lower="0." upper="0.024" effort="100.0" velocity="1.0" />
  </joint>
  <joint name="RevoluteJoint" type="continuous">
    <origin xyz="0. -0. 0." rpy="0. 0. 0." />
    <parent link="World" />
    <child link="rotation_pivot" />
    <axis xyz="1. 0. 0." />
  </joint>
  <link name="World">
    <inertial><origin xyz="0.000000 0.000000 0.022350" rpy="0 0 0" /><mass value="0.3005" /><inertia ixx="0.000195784" ixy="0" ixz="0" iyy="0.000244368" iyz="0" izz="0.000340094" /></inertial><visual>
      <origin xyz="-0.0447325 -0. 0. " rpy="0. 1.5707964 0. " />
      <geometry>
        <mesh filename="meshes/base_pivot_Mesh.obj" scale="1. 1. 1." />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0447325 -0. 0. " rpy="0. 1.5707964 0. " />
      <geometry>
        <mesh filename="meshes/base_pivot_Mesh.obj" scale="1. 1. 1." />
      </geometry>
    </collision>
  </link>
  <link name="lamp_pivot">
    <!-- CAD mass is 22 g; scaled to 0.20 kg so GPU PhysX grasp contacts stay stable. -->
    <inertial>
      <origin xyz="0.030000 0.000000 0.000000" rpy="0 0 0" />
      <mass value="0.20" />
      <inertia ixx="7.84e-05" ixy="0" ixz="0" iyy="1.46e-04" iyz="0" izz="1.46e-04" />
    </inertial>
    <visual>
      <origin xyz="0. 0. 0." rpy="-1.5434489 -1.4170299 1.5429671" />
      <geometry>
        <mesh filename="meshes/Corpo1_Mesh.obj" scale="1. 1. 1." />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0. 0. 0." rpy="-1.5434489 -1.4170299 1.5429671" />
      <geometry>
        <mesh filename="meshes/tn__Corpo11_j7m1J_Mesh.obj" scale="1. 1. 1." />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0. 0. 0." rpy="-1.5434489 -1.4170299 1.5429671" />
      <geometry>
        <mesh filename="meshes/tn__Corpo12_j7m1J_Mesh.obj" scale="1. 1. 1." />
      </geometry>
    </visual>
    <!-- Primitive colliders along link +X. CAD shells as convex hulls fill the
         bulb and generate thousands of contact patches on grasp. -->
    <collision>
      <origin xyz="-0.015 0. 0." rpy="0. 1.5707964 0." />
      <geometry>
        <cylinder radius="0.014" length="0.030" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.035 0. 0." rpy="0. 1.5707964 0." />
      <geometry>
        <cylinder radius="0.028" length="0.080" />
      </geometry>
    </collision>
  </link>
  <link name="rotation_pivot">
    <inertial><origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0" /><mass value="0.0500" /><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05" /></inertial><visual>
      <origin xyz="-0.0390718 0. -0. " rpy="0. 1.5707964 0. " />
      <geometry>
        <cylinder radius="0.005" length="0.01" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0390718 0. -0. " rpy="0. 1.5707964 0. " />
      <geometry>
        <cylinder radius="0.005" length="0.01" />
      </geometry>
    </collision>
  </link>
</robot>